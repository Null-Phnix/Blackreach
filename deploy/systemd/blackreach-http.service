[Unit]
Description=Blackreach HTTP agent gateway
After=network-online.target starsearch-daemon.service
Wants=network-online.target starsearch-daemon.service

[Service]
Type=simple
WorkingDirectory=/mnt/WorkDrive/AI_Projects/Blackreach
ExecStart=/mnt/WorkDrive/AI_Projects/Blackreach/.venv/bin/python -c "from mcp_server.blackreach_http_server import main; main()" --no-banner
Environment=BLACKREACH_BROWSER_BACKEND=starsearch
Environment=BLACKREACH_HUMAN_LEVEL=1
Environment=BLACKREACH_MAX_RETAINED_JOBS=500
Environment=BLACKREACH_JOB_STATE_FILE=%h/.local/state/blackreach/jobs.json
Environment=HUGINN_API_KEY_FILE=%h/.config/huginn/api-key
Environment=BLACKREACH_API_KEY_FILE=%h/.config/blackreach/api-key
ExecStartPre=/usr/bin/test -s %h/.config/huginn/api-key
ExecStartPre=/usr/bin/test -s %h/.config/blackreach/api-key
ExecStartPre=/mnt/WorkDrive/AI_Projects/Blackreach/.venv/bin/python -c "import starsearch, waitress"
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
